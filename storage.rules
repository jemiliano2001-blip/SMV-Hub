rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Correo con acceso admin garantizado, fijo como red de seguridad — debe
    // coincidir con CORREO_ADMIN_BREAK_GLASS en lib/authorized-emails.ts.
    function esCorreoBreakGlass() {
      return request.auth.token.email == 'jemiliano2001@gmail.com';
    }

    // App Check: el cliente web debe enviar token válido (reCAPTCHA v3 + debug en dev).
    // ponytail: desactivado 2026-07-13, App Check devuelve 403 en prod (site key
    // sin registrar/dominio no autorizado) y bloqueaba a todo el mundo, incluido
    // el break-glass. Reactivar cambiando a `request.app != null` cuando se
    // valide en Firebase Console → App Check (ver docs/infra/app-check-setup.md).
    function appCheckValido() {
      return true;
    }

    // La autorización vive en la colección `usuarios` de la base Firestore
    // nombrada "compras-americanas", que estas reglas no pueden leer (las
    // cross-service rules de Storage solo alcanzan la base "(default)"). El
    // acceso se decide con el custom claim `smvHubActivo` del ID token, que
    // lib/usuarios-admin.ts sincroniza al crear usuarios y al cambiar su acceso.
    function esUsuarioAutorizado() {
      return request.auth != null && request.auth.token.email_verified == true &&
             appCheckValido() &&
             (esCorreoBreakGlass() || esSuperAdmin() || request.auth.token.smvHubActivo == true);
    }

    // Los permisos por módulo se estampan como custom claims porque Storage no
    // puede consultar la base Firestore nombrada "compras-americanas".
    function tieneModulo(modulo) {
      return esCorreoBreakGlass() ||
             esSuperAdmin() ||
             (request.auth.token.smvHubModulos is list &&
              modulo in request.auth.token.smvHubModulos);
    }

    function esSuperAdmin() {
      return esCorreoBreakGlass() || request.auth.token.smvHubEsSuperAdmin == true;
    }

    // Imágenes de órdenes: solo usuarios autorizados.
    match /ordenes/{imagen=**} {
      allow read: if esUsuarioAutorizado();

      // En subidas se valida tamaño (<10 MB) y tipo (imagen o PDF de factura).
      allow write: if esUsuarioAutorizado()
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Fotos de pedidos de almacén: solo usuarios autorizados.
    match /pedidos-almacen/{imagen=**} {
      allow read: if esUsuarioAutorizado() && tieneModulo('pedidos-almacen');

      allow write: if esUsuarioAutorizado()
                   && tieneModulo('pedidos-almacen')
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Comprobantes de caja chica: solo usuarios autorizados.
    match /caja-chica/{archivo=**} {
      allow read: if esUsuarioAutorizado() && tieneModulo('caja-chica');

      allow write: if esUsuarioAutorizado()
                   && tieneModulo('caja-chica')
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Fotos de gafetes: contienen datos biométricos y son exclusivas de super-admin.
    match /gafetes/{operadorId}/{archivo} {
      allow read: if esUsuarioAutorizado() && esSuperAdmin();
      allow write: if esUsuarioAutorizado() && esSuperAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Rutas compartidas de Tool Crib (SMV-VISION en smv-brain)
    match /tool-crib/{customer}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('model/stl')
                       || request.resource.contentType.matches('application/sla')
                       || request.resource.contentType.matches('image/jpeg'));
    }
    match /toolcrib/{partId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf');
    }

    // Todo lo demás: denegado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
