# Configuración NO secreta de las Functions del Hub (codebase smv-hub). Los secretos van en
# Secret Manager (runWith({ secrets })), nunca aquí. Firebase CLI carga este archivo al
# desplegar y lo inyecta como variables de entorno del runtime.

# App Check en callables — desactivado temporalmente (2026-09-14).
# El cliente web no inicializa App Check (NEXT_PUBLIC_APP_CHECK_ENABLED no está activo desde
# que la configuración incompleta de reCAPTCHA causó 403 en producción) y las rules de
# Firestore/Storage tampoco lo exigen; solo los callables lo exigían, así que TODOS los botones
# manuales (sync compras/facturas/ventas, refrescar índice, integridad) fallaban con
# "App Check verification failed". Los callables siguen protegidos por Firebase Auth +
# super-admin/módulos (getCallablePrincipal). Para volver a exigirlo: completar
# docs/infra/app-check-setup.md, quitar esta línea y redesplegar los callables.
APP_CHECK_ENFORCE=false
