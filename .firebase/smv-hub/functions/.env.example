# =============================================================================
# SMV Hub — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores.
#
# Desarrollo: usa el proyecto Firebase `smv-brain-dev` (crear en consola).
# Producción: solo CI/CD despliega a `smv-brain`; no uses prod en .env.local.
# =============================================================================

# --- Firebase (Web App) -------------------------------------------------------
# Dev:  Firebase Console → smv-brain-dev → Project settings → Your apps
# Prod: smv-brain (solo secrets de GitHub Actions, no en .env.local)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=smv-brain-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Base Firestore nombrada (misma en dev y prod)
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=compras-americanas

# --- App Check (reCAPTCHA v3) -------------------------------------------------
# Firebase Console → App Check → Apps → reCAPTCHA v3 → copiar site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Solo desarrollo: generar debug token en App Check → Manage debug tokens
NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# --- Gemini (extracción IA de facturas) ---------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL_SAT=gemini-3.1-flash-lite

# --- Autorización extra (opcional; también actualizar firestore.rules) --------
# AUTHORIZED_EMAILS_EXTRA=persona@smv.com,otro@smv.com
# NEXT_PUBLIC_AUTHORIZED_EMAILS_EXTRA=persona@smv.com

# --- Desarrollo local ---------------------------------------------------------
# "true" omite login de UI (NO usar con Firestore real; solo maquetado)
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true
