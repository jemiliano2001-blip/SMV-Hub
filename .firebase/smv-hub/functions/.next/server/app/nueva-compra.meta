{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/nueva-compra/layout,_N_T_/nueva-compra/page,_N_T_/nueva-compra"
  },
  "segmentPaths": [
    "/_tree",
