{
  "firestore": {
    "database": "compras-americanas",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "codebase": "smv-hub"
  },
  "hosting": {
    "site": "smv-hub",
    "source": ".",
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "1GiB",
      "timeoutSeconds": 120
    },
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scratch/**"
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
