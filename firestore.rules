rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de autenticación / autorización ──────────────────────────────

    // Exige sesión con correo verificado (las cuentas de Google lo están).
    function estaAutenticado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // App Check: el cliente web debe enviar token válido (reCAPTCHA v3 + debug en dev).
    // ponytail: desactivado 2026-07-13, App Check devuelve 403 en prod (site key
    // sin registrar/dominio no autorizado) y bloqueaba a todo el mundo, incluido
    // el break-glass. Reactivar cambiando a `request.app != null` cuando se
    // valide en Firebase Console → App Check (ver docs/infra/app-check-setup.md).
    function appCheckValido() {
      return true;
    }

    // Correo con acceso admin garantizado, fijo como red de seguridad — debe
    // coincidir con CORREO_ADMIN_BREAK_GLASS en lib/authorized-emails.ts.
    function esCorreoBreakGlass() {
      return request.auth.token.email == 'jemiliano2001@gmail.com';
    }

    // Autorización real vive en la colección `usuarios` (administrada desde
    // /usuarios): el documento con id = uid debe existir y tener activo == true.
    function esUsuarioAutorizado() {
      return estaAutenticado() &&
        appCheckValido() &&
        (
          esCorreoBreakGlass() ||
          (
            exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true
          )
        );
    }

    function docUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Módulos personalizados (modulos[]) con fallback a rol/plantilla legacy.
    function tieneModulo(modulo) {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        (
          (docUsuario().keys().hasAny(['modulos']) && modulo in docUsuario().modulos) ||
          (
            !docUsuario().keys().hasAny(['modulos']) &&
            (
              (modulo == 'finanzas' && (docUsuario().rol == 'admin' || docUsuario().plantilla == 'admin')) ||
              (modulo == 'caja-chica' && docUsuario().rol in ['admin', 'compras']) ||
              (modulo == 'caja-chica' && docUsuario().plantilla in ['admin', 'compras']) ||
              (modulo == 'auditoria' && (docUsuario().rol == 'admin' || docUsuario().plantilla == 'admin')) ||
              (modulo == 'usuarios' && (docUsuario().rol == 'admin' || docUsuario().plantilla == 'admin')) ||
              (modulo == 'nueva-compra' && docUsuario().rol in ['admin', 'compras']) ||
              (modulo == 'nueva-compra' && docUsuario().plantilla in ['admin', 'compras']) ||
              (modulo == 'pedidos-almacen' && docUsuario().rol in ['admin', 'compras', 'almacen']) ||
              (modulo == 'pedidos-almacen' && docUsuario().plantilla in ['admin', 'compras', 'almacen']) ||
              (modulo == 'endmills' && docUsuario().rol in ['admin', 'compras']) ||
              (modulo == 'endmills' && docUsuario().plantilla in ['admin', 'compras'])
            )
          )
        );
    }

    function esSuperAdminDoc() {
      // Si el documento ya trae el campo explícito, manda sobre el fallback legado
      // (permite revocar super-admin a un usuario con rol/plantilla "admin").
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        (
          ('esSuperAdmin' in docUsuario() && docUsuario().esSuperAdmin == true) ||
          (!('esSuperAdmin' in docUsuario()) &&
            (docUsuario().rol == 'admin' || docUsuario().plantilla == 'admin'))
        );
    }

    // ── Usuarios (roles y acceso, administrados desde /usuarios) ─────────────

    match /usuarios/{uid} {
      // Cada quien puede leer su propio documento — AuthGuard/NavBar lo usan
      // para calcular su rol. El listado completo para /usuarios se sirve vía
      // Route Handler con Admin SDK, no lectura directa de colección.
      allow read: if estaAutenticado() && appCheckValido() && request.auth.uid == uid;
      // Todas las escrituras pasan por app/api/usuarios/* (Admin SDK, que
      // ignora estas reglas) — nunca directo desde el navegador.
      allow write: if false;

      // Leídos de notificaciones in-app: solo el dueño del uid.
      match /notificaciones_leidas/{notificacionId} {
        // En lecturas no existe request.resource. Mantener la validación de
        // payload únicamente en escrituras permite que el listener confirme
        // los marcadores persistidos sin relajar el aislamiento por usuario.
        allow read: if estaAutenticado()
          && appCheckValido()
          && request.auth.uid == uid;
        allow create, update: if estaAutenticado()
          && appCheckValido()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['leidoEn'])
          && request.resource.data.leidoEn is timestamp;
        allow delete: if estaAutenticado()
          && appCheckValido()
          && request.auth.uid == uid;
      }
    }

    // ── Validación de datos (frontera real del lado servidor) ────────────────

    // Monto financiero: nulo o número no negativo. Bloquea negativos y tipos
    // erróneos que romperían los cálculos de presupuesto/inventario.
    function montoValido(v) {
      return v == null || (v is number && v >= 0);
    }

    function ordenValida(d) {
      return d.proveedor is string &&
             d.requisitor is string &&
             d.ordenTrabajo is string &&
             d.empresa is string &&
             d.moneda is string &&
             d.estado in ['pendiente', 'aprobada', 'rechazada'] &&
             montoValido(d.subtotal) &&
             montoValido(d.impuestos) &&
             montoValido(d.total) &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    function cotizacionValida(d) {
      return d.proveedor is string &&
             d.descripcion is string &&
             d.moneda in ['USD', 'MXN'] &&
             d.estatus in ['cotizado', 'cancelado', 'revisar'] &&
             d.ubicacion in ['MX', 'USA'] &&
             montoValido(d.precioUnitario) &&
             montoValido(d.total) &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    function comprasOdooValida(d) {
      return d.proveedor is string &&
             d.odooName is string &&
             d.moneda in ['MXN', 'USD'] &&
             montoValido(d.total) &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    function requisicionValida(d) {
      return d.tipo in ['general', 'automatizacion'] &&
             d.solicitante is string &&
             d.estado in ['no_comprado', 'en_proceso', 'comprado', 'parcial', 'recibido'] &&
             d.fechaPedido is string &&
             d.descripcion is string &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    // ── Órdenes de compra ────────────────────────────────────────────────────

    match /ordenes/{ordenId} {
      allow read: if esUsuarioAutorizado();

      allow create: if esUsuarioAutorizado()
                    && ordenValida(request.resource.data);

      // En la actualización, el audit trail es inmutable: la fecha de creación
      // no puede alterarse y la marca de actualización debe avanzar.
       allow update: if esUsuarioAutorizado()
                     && ordenValida(request.resource.data)
                     && request.resource.data.creadoEn == resource.data.creadoEn
                     && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if esUsuarioAutorizado();
    }

    // ── Cotizaciones (base de datos histórica buscable) ──────────────────────

    match /cotizaciones/{cotizacionId} {
      allow read: if esUsuarioAutorizado();

      allow create: if esUsuarioAutorizado()
                    && cotizacionValida(request.resource.data);

      // El audit trail es inmutable: la fecha de creación no cambia y la marca
      // de actualización debe avanzar.
       allow update: if esUsuarioAutorizado()
                     && cotizacionValida(request.resource.data)
                     && request.resource.data.creadoEn == resource.data.creadoEn
                     && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if esUsuarioAutorizado();
    }

    // ── Compras / Cotizaciones Odoo ──────────────────────────────────────────

    match /compras_odoo/{compraOdooId} {
      allow read: if esUsuarioAutorizado();

      allow create: if esUsuarioAutorizado()
                    && comprasOdooValida(request.resource.data);

       allow update: if esUsuarioAutorizado()
                     && comprasOdooValida(request.resource.data)
                     && request.resource.data.creadoEn == resource.data.creadoEn
                     && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if esUsuarioAutorizado() && (esSuperAdminDoc() || esCorreoBreakGlass());
    }

    // ── Requisiciones (seguimiento de pedidos por solicitante) ───────────────

    match /requisiciones/{requisicionId} {
      allow read: if esUsuarioAutorizado();

      allow create: if esUsuarioAutorizado()
                    && requisicionValida(request.resource.data);

      // El audit trail es inmutable: la fecha de creación no cambia y la marca
      // de actualización debe avanzar.
      allow update: if esUsuarioAutorizado()
                    && requisicionValida(request.resource.data)
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if esUsuarioAutorizado();
    }

    // ── Catálogo de operadores ────────────────────────────────────────────────

    function operadorValido(d) {
      return d.nombre is string &&
             d.area in ['taller', 'diseno', 'automatizacion', 'cnc', 'limpieza', 'administracion'] &&
             d.activo is bool &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    match /operadores/{operadorId} {
      allow read: if esUsuarioAutorizado();

      allow create: if esUsuarioAutorizado()
                    && operadorValido(request.resource.data);

      allow update: if esUsuarioAutorizado()
                    && operadorValido(request.resource.data)
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if esUsuarioAutorizado();
    }

    // ── Gafetes de personal (datos sensibles) ───────────────────────────────

    function gafeteValido(d, gafeteId) {
      return d.keys().hasOnly([
               'operadorId', 'cargo', 'fechaIngreso', 'nss',
               'rfc', 'fotoPath', 'fotoAjuste', 'creadoEn', 'actualizadoEn'
             ]) &&
             d.operadorId == gafeteId &&
             d.cargo is string && d.fechaIngreso is string &&
             d.nss is string && d.rfc is string &&
             d.fotoPath is string &&
             d.fotoAjuste is map &&
             d.fotoAjuste.keys().hasOnly(['rotacion', 'zoom', 'desplazamientoX', 'desplazamientoY']) &&
             d.fotoAjuste.rotacion in [0, 90, 180, 270] &&
             d.fotoAjuste.zoom is number && d.fotoAjuste.zoom >= 0.75 && d.fotoAjuste.zoom <= 2.5 &&
             d.fotoAjuste.desplazamientoX is number && d.fotoAjuste.desplazamientoX >= -50 && d.fotoAjuste.desplazamientoX <= 50 &&
             d.fotoAjuste.desplazamientoY is number && d.fotoAjuste.desplazamientoY >= -50 && d.fotoAjuste.desplazamientoY <= 50 &&
             d.creadoEn is timestamp && d.actualizadoEn is timestamp;
    }

    match /gafetes/{gafeteId} {
      allow read: if esUsuarioAutorizado() && (esCorreoBreakGlass() || esSuperAdminDoc());
      allow create: if esUsuarioAutorizado() && (esCorreoBreakGlass() || esSuperAdminDoc()) &&
                    exists(/databases/$(database)/documents/operadores/$(gafeteId)) &&
                    gafeteValido(request.resource.data, gafeteId);
      allow update: if esUsuarioAutorizado() && (esCorreoBreakGlass() || esSuperAdminDoc()) &&
                    gafeteValido(request.resource.data, gafeteId) &&
                    request.resource.data.operadorId == resource.data.operadorId &&
                    request.resource.data.creadoEn == resource.data.creadoEn &&
                    request.resource.data.actualizadoEn >= resource.data.actualizadoEn;
      allow delete: if esUsuarioAutorizado() && (esCorreoBreakGlass() || esSuperAdminDoc());
    }

    // ── Almacén (Entradas y Salidas) ─────────────────────────────────────────

    function entradaAlmacenValida(d) {
      return d.fecha is string &&
             d.descripcion is string &&
             d.cantidad is string &&
             d.cargoA is string &&
             d.recibio is string &&
             d.estatus in ['pendiente', 'entregado', 'devuelto'] &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    match /almacen-entradas/{entradaId} {
      allow read: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('almacen'));

      allow create: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('almacen'))
                    && entradaAlmacenValida(request.resource.data);

      allow update: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('almacen'))
                    && entradaAlmacenValida(request.resource.data)
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('almacen'));
    }

    function salidaAlmacenValida(d) {
      return d.fecha is string &&
             d.herramienta is string &&
             d.cantidad is number &&
             d.operador is string &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    match /almacen-salidas/{salidaId} {
      allow read: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('almacen'));

      allow create: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('almacen'))
                    && salidaAlmacenValida(request.resource.data);

      allow update: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('almacen'))
                    && salidaAlmacenValida(request.resource.data)
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('almacen'));
    }

    // ── Pedidos de almacén (captura móvil: "necesito que compres X") ────────

    function esPedidoAlmacenCreador() {
      return esUsuarioAutorizado() &&
        (esCorreoBreakGlass() || tieneModulo('pedidos-almacen'));
    }

    // Solo quien compra puede cambiar el estado del pedido o vincularlo a una
    // orden — el encargado de almacén únicamente crea, no gestiona el estado.
    function esPedidoAlmacenGestor() {
      return esUsuarioAutorizado() &&
        (esCorreoBreakGlass() || (tieneModulo('pedidos-almacen') && tieneModulo('nueva-compra')));
    }

    function pedidoAlmacenValido(d) {
      return d.descripcion is string &&
             d.urgente is bool &&
             d.estado in ['pendiente', 'comprado', 'cancelado'] &&
             d.solicitadoPorUid is string &&
             d.solicitadoPorNombre is string &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    match /pedidos-almacen/{pedidoId} {
      allow read: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('pedidos-almacen'));

      allow create: if esPedidoAlmacenCreador()
                    && pedidoAlmacenValido(request.resource.data)
                    && request.resource.data.estado == 'pendiente';

      // El audit trail es inmutable: la fecha de creación no cambia y la marca
      // de actualización debe avanzar.
      allow update: if esPedidoAlmacenGestor()
                    && pedidoAlmacenValido(request.resource.data)
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if false;
    }

    // Endmills China: catálogo real y ciclos de compra revisados.
    function esUsuarioEndmills() {
      return esUsuarioAutorizado() &&
        (esCorreoBreakGlass() || tieneModulo('endmills'));
    }

    function categoriaEndmillValida(categoria) {
      return categoria in [
        'FLAT', 'BALL', 'LARGO_FLAT', 'LARGO_BOLA',
        'EXTRA_LARGO_FLAT', 'EXTRA_LARGO_BOLA', 'RUPA_CARBURO'
      ];
    }

    function medidaEndmillValida(d) {
      return d.keys().hasOnly([
               'orden', 'categoria', 'medidaPulgadas', 'descripcion',
               'stockActual', 'stockActualizadoEn', 'precioActualUSD',
               'cotizacionFecha', 'specPropuesta', 'requiereConfirmacion',
               'notas', 'objetivoPar', 'ultimoPedidoId', 'creadoEn',
               'actualizadoEn'
             ]) &&
             d.orden is int && d.orden > 0 &&
             categoriaEndmillValida(d.categoria) &&
             d.medidaPulgadas is string && d.descripcion is string &&
             d.stockActual is int && d.stockActual >= 0 &&
             d.stockActualizadoEn is timestamp &&
             d.precioActualUSD is number && d.precioActualUSD >= 0 &&
             d.cotizacionFecha is string && d.specPropuesta is string &&
             d.requiereConfirmacion is bool &&
             (d.notas == null || d.notas is string) &&
             (d.objetivoPar == null || (d.objetivoPar is int && d.objetivoPar >= 0)) &&
             (d.ultimoPedidoId == null || d.ultimoPedidoId is string) &&
             d.creadoEn is timestamp && d.actualizadoEn is timestamp;
    }

    function baseEndmillRespaldada(medidaId, d) {
      return (d.objetivoPar == null && d.ultimoPedidoId == null) ||
        (
          d.objetivoPar is int && d.ultimoPedidoId is string &&
          existsAfter(/databases/$(database)/documents/endmills-pedidos/$(d.ultimoPedidoId)) &&
          existsAfter(/databases/$(database)/documents/endmills-pedido-partidas/$(d.ultimoPedidoId + '_' + medidaId)) &&
          getAfter(/databases/$(database)/documents/endmills-pedido-partidas/$(d.ultimoPedidoId + '_' + medidaId)).data.objetivoPar == d.objetivoPar
        );
    }

    match /endmills-medidas/{medidaId} {
      allow read: if esUsuarioEndmills();
      // `toFirestore()` (lib/firestore-helpers.ts) descarta `id` antes de escribir,
      // así que el documento nunca trae ese campo: no comparar contra medidaId aquí.
      allow create: if esUsuarioEndmills() &&
        medidaEndmillValida(request.resource.data);
      allow delete: if false;
      // El cliente solo actualiza stock, orden (reordenar), la confirmación de
      // spec/precio, o una base respaldada por la partida de un pedido real.
      // categoria/medidaPulgadas/descripcion/precioActualUSD/cotizacionFecha/
      // specPropuesta/notas solo se fijan al crear la medida (lib/endmills.ts).
      allow update: if esUsuarioEndmills() &&
        medidaEndmillValida(request.resource.data) &&
        request.resource.data.creadoEn == resource.data.creadoEn &&
        request.resource.data.actualizadoEn >= resource.data.actualizadoEn &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orden', 'stockActual', 'stockActualizadoEn', 'objetivoPar',
          'ultimoPedidoId', 'requiereConfirmacion', 'actualizadoEn'
        ]) &&
        // La confirmación de spec/precio solo se resuelve (true → false); nunca
        // se puede volver a marcar una medida como "por confirmar" desde el cliente.
        (
          request.resource.data.requiereConfirmacion == resource.data.requiereConfirmacion ||
          request.resource.data.requiereConfirmacion == false
        ) &&
        baseEndmillRespaldada(medidaId, request.resource.data);
    }

    function proveedorEndmillsValido(p) {
      return p.keys().hasOnly(['nombre', 'contacto', 'email', 'origen']) &&
             p.nombre is string && p.contacto is string &&
             p.email is string && p.origen is string;
    }

    function pedidoEndmillsValido(d) {
      return d.keys().hasOnly([
               'fecha', 'numeroProveedor', 'estado', 'proveedor', 'moneda',
               'costoItemsUSD', 'aliCostUSD', 'shippingUSD', 'totalUSD',
               'costosAdicionalesConfirmados', 'numeroPartidas',
               'numeroPiezas', 'origen', 'motivoCancelacion',
               'fechaRecepcionCompleta', 'diasLeadTime', 'tipoCambioUSD',
               'creadoPorUid', 'creadoPorNombre', 'creadoEn', 'actualizadoEn'
             ]) &&
             d.fecha is string &&
             (d.numeroProveedor == null || d.numeroProveedor is string) &&
             d.estado in ['confirmado', 'recibido', 'cancelado'] &&
             proveedorEndmillsValido(d.proveedor) && d.moneda == 'USD' &&
             d.costoItemsUSD is number && d.costoItemsUSD >= 0 &&
             d.aliCostUSD is number && d.aliCostUSD >= 0 &&
             d.shippingUSD is number && d.shippingUSD >= 0 &&
             d.totalUSD is number && d.totalUSD >= 0 &&
             d.costosAdicionalesConfirmados is bool &&
             d.numeroPartidas is int && d.numeroPartidas > 0 &&
             d.numeroPiezas is int && d.numeroPiezas > 0 &&
             d.origen in ['semilla', 'manual'] &&
             (d.motivoCancelacion == null || d.motivoCancelacion is string) &&
             // Campos agregados después del lanzamiento: los pedidos creados
             // antes no traen la llave, y leer una llave ausente en Rules es un
             // error de evaluación que denegaría recibir/cancelar esos pedidos.
             // `get(campo, null)` los trata como null sin aflojar el tipo.
             (d.get('fechaRecepcionCompleta', null) == null ||
              d.get('fechaRecepcionCompleta', null) is string) &&
             (d.get('diasLeadTime', null) == null ||
              (d.get('diasLeadTime', null) is int && d.get('diasLeadTime', null) >= 0)) &&
             (d.get('tipoCambioUSD', null) == null ||
              (d.get('tipoCambioUSD', null) is number && d.get('tipoCambioUSD', null) > 0)) &&
             d.creadoPorUid is string && d.creadoPorNombre is string &&
             d.creadoEn is timestamp && d.actualizadoEn is timestamp;
    }

    match /endmills-pedidos/{pedidoId} {
      allow read: if esUsuarioEndmills();
      allow create: if esUsuarioEndmills() &&
        pedidoEndmillsValido(request.resource.data) &&
        request.resource.data.estado == 'confirmado' &&
        request.resource.data.origen == 'manual' &&
        request.resource.data.creadoPorUid == request.auth.uid;
      allow update: if esUsuarioEndmills() &&
        pedidoEndmillsValido(request.resource.data) &&
        request.resource.data.creadoEn == resource.data.creadoEn &&
        request.resource.data.actualizadoEn >= resource.data.actualizadoEn &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'motivoCancelacion', 'fechaRecepcionCompleta', 'diasLeadTime', 'actualizadoEn'
        ]) &&
        (
          (resource.data.estado == 'confirmado' && request.resource.data.estado in ['confirmado', 'recibido', 'cancelado']) ||
          (resource.data.estado == 'recibido' && request.resource.data.estado == 'recibido') ||
          (resource.data.estado == 'cancelado' && request.resource.data.estado == 'cancelado')
        );
      allow delete: if false;
    }

    function partidaEndmillsValida(d) {
      return d.keys().hasOnly([
               'pedidoId', 'fechaPedido', 'tipo', 'medidaId', 'categoria',
               'medidaPulgadas', 'descripcion', 'spec', 'stockAntesPedido',
               'cantidadPedida', 'cantidadRecibida', 'recepciones', 'precioUnitarioUSD',
               'subtotalUSD', 'objetivoPar', 'requiereConfirmacionAlCrear',
               'confirmacionResuelta', 'creadoEn', 'actualizadoEn'
             ]) &&
             d.pedidoId is string && d.fechaPedido is string &&
             d.tipo in ['catalogada', 'fuera_catalogo'] &&
             (
               (d.tipo == 'catalogada' && d.medidaId is string && categoriaEndmillValida(d.categoria)) ||
               (d.tipo == 'fuera_catalogo' && d.medidaId == null && d.categoria == null)
             ) &&
             d.medidaPulgadas is string && d.descripcion is string && d.spec is string &&
             (d.stockAntesPedido == null || (d.stockAntesPedido is int && d.stockAntesPedido >= 0)) &&
             d.cantidadPedida is int && d.cantidadPedida > 0 &&
             d.cantidadRecibida is int && d.cantidadRecibida >= 0 &&
             d.cantidadRecibida <= d.cantidadPedida &&
             // Mismo caso que en el pedido: las partidas anteriores al cambio
             // no traen `recepciones`.
             (d.get('recepciones', null) == null || d.get('recepciones', null) is list) &&
             d.precioUnitarioUSD is number && d.precioUnitarioUSD >= 0 &&
             d.subtotalUSD is number && d.subtotalUSD >= 0 &&
             (d.objetivoPar == null || (d.objetivoPar is int && d.objetivoPar >= 0)) &&
             d.requiereConfirmacionAlCrear is bool && d.confirmacionResuelta is bool &&
             (!d.requiereConfirmacionAlCrear || d.confirmacionResuelta) &&
             d.creadoEn is timestamp && d.actualizadoEn is timestamp;
    }

    match /endmills-pedido-partidas/{partidaId} {
      allow read: if esUsuarioEndmills();
      allow create: if esUsuarioEndmills() &&
        partidaEndmillsValida(request.resource.data) &&
        request.resource.data.tipo == 'catalogada' &&
        partidaId == request.resource.data.pedidoId + '_' + request.resource.data.medidaId &&
        existsAfter(/databases/$(database)/documents/endmills-medidas/$(request.resource.data.medidaId)) &&
        existsAfter(/databases/$(database)/documents/endmills-pedidos/$(request.resource.data.pedidoId)) &&
        getAfter(/databases/$(database)/documents/endmills-pedidos/$(request.resource.data.pedidoId)).data.estado == 'confirmado';
      allow update: if esUsuarioEndmills() &&
        partidaEndmillsValida(request.resource.data) &&
        request.resource.data.creadoEn == resource.data.creadoEn &&
        request.resource.data.actualizadoEn >= resource.data.actualizadoEn &&
        request.resource.data.cantidadRecibida >= resource.data.cantidadRecibida &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cantidadRecibida', 'recepciones', 'actualizadoEn'
        ]);
      allow delete: if false;
    }

    // ── Notificaciones in-app (Operación del Taller) ─────────────────────────

    // La consulta del cliente se divide por audiencia y destinatario. Esta
    // función debe poder evaluar cada documento de esas consultas por separado.
    function puedeVerNotificacion(d) {
      return esUsuarioAutorizado() &&
        d.keys().hasAll(['audiencia', 'destinatarioUid']) &&
        (
          d.destinatarioUid == request.auth.uid ||
          (d.audiencia == 'pedidos-almacen' && tieneModulo('pedidos-almacen')) ||
          (d.audiencia == 'requisiciones' && tieneModulo('requisiciones')) ||
          (d.audiencia == 'documentos-venta' && atiendeDocumentosVenta()) ||
          (d.audiencia == 'endmills' && tieneModulo('endmills')) ||
          (d.audiencia == 'banos' && esSuperAdminDoc())
        );
    }

    function notificacionValida(d) {
      return d.keys().hasAll([
               'tipo', 'titulo', 'cuerpo', 'origenModulo', 'origenId',
               'audiencia', 'destinatarioUid', 'href', 'creadoPorUid',
               'creadoPorNombre', 'creadoEn', 'actualizadoEn'
             ]) &&
             d.tipo in [
               'pedido_almacen_creado',
               'pedido_almacen_estado',
               'requisicion_creada',
               'requisicion_estado',
               'banos_solicitud_creada',
               'banos_solicitud_resuelta',
               'solicitud_documento_creada',
               'solicitud_documento_estado',
               'solicitud_documento_mensaje',
               'endmills_stock_critico'
             ] &&
             d.titulo is string &&
             d.cuerpo is string &&
             d.origenModulo in ['pedidos-almacen', 'requisiciones', 'documentos-venta', 'banos', 'endmills'] &&
             d.origenId is string &&
             d.audiencia in ['pedidos-almacen', 'requisiciones', 'documentos-venta', 'banos', 'endmills'] &&
             (d.destinatarioUid == null || d.destinatarioUid is string) &&
             d.href is string &&
             d.creadoPorUid is string &&
             d.creadoPorNombre is string &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp &&
             (
               (d.tipo in ['pedido_almacen_creado', 'pedido_almacen_estado'] &&
                d.origenModulo == 'pedidos-almacen' && d.audiencia == 'pedidos-almacen' &&
                d.destinatarioUid == null) ||
               (d.tipo in ['requisicion_creada', 'requisicion_estado'] &&
                d.origenModulo == 'requisiciones' && d.audiencia == 'requisiciones' &&
                d.destinatarioUid == null) ||
               (d.tipo in ['solicitud_documento_creada', 'solicitud_documento_estado', 'solicitud_documento_mensaje'] &&
                d.origenModulo == 'documentos-venta' && d.audiencia == 'documentos-venta' &&
                d.destinatarioUid is string) ||
               (d.tipo in ['banos_solicitud_creada', 'banos_solicitud_resuelta'] &&
                d.origenModulo == 'banos' && d.audiencia == 'banos' &&
                d.destinatarioUid is string) ||
               (d.tipo == 'endmills_stock_critico' &&
                d.origenModulo == 'endmills' && d.audiencia == 'endmills' &&
                d.destinatarioUid == null)
             );
    }

    function puedeCrearNotificacion() {
      return esUsuarioAutorizado() &&
        request.resource.data.creadoPorUid == request.auth.uid &&
        notificacionValida(request.resource.data) &&
        (
          (esCorreoBreakGlass() && request.resource.data.audiencia != 'banos') ||
          (
            (request.resource.data.audiencia == 'pedidos-almacen' &&
             tieneModulo('pedidos-almacen')) ||
            (request.resource.data.audiencia == 'requisiciones' &&
             tieneModulo('requisiciones')) ||
            (request.resource.data.audiencia == 'documentos-venta' &&
             tieneModulo('documentos-venta') &&
             exists(/databases/$(database)/documents/solicitudes_documento/$(request.resource.data.origenId)) &&
             get(/databases/$(database)/documents/solicitudes_documento/$(request.resource.data.origenId)).data.solicitadoPorUid ==
               request.resource.data.destinatarioUid) ||
            // La alerta de stock crítico la emite el propio cliente al guardar
            // stock, así que el origen debe ser una medida real del catálogo.
            (request.resource.data.audiencia == 'endmills' &&
             tieneModulo('endmills') &&
             exists(/databases/$(database)/documents/endmills-medidas/$(request.resource.data.origenId)))
          )
        );
    }

    match /notificaciones/{notificacionId} {
      allow read: if puedeVerNotificacion(resource.data);
      allow create: if puedeCrearNotificacion();
      allow update, delete: if false;
    }

    // ── Control de Baños ─────────────────────────────────────────────────────

    function registroBanoValido(d) {
      return d.operador is string &&
             d.bano in ['Baño #1', 'Baño #2', 'CNC', 'Automatizacion'] &&
             d.horaEntrada is string &&
             d.fecha is string &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    match /registros-bano/{banoId} {
      allow read: if esUsuarioAutorizado();

      allow create: if esUsuarioAutorizado()
                    && registroBanoValido(request.resource.data);

      allow update: if esUsuarioAutorizado()
                    && registroBanoValido(request.resource.data)
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      // Antes cualquier usuario autorizado podía borrar directo — la UI ya
      // ocultaba el botón a quien no fuera súper admin, pero la regla no lo
      // exigía. El flujo de solicitud de borrado (Route Handler + Admin SDK)
      // solo tiene sentido si esto queda cerrado también aquí.
      allow delete: if esUsuarioAutorizado() && (esSuperAdminDoc() || esCorreoBreakGlass());
    }

    // ── Solicitudes de eliminación de registros de baño ──────────────────────
    // Toda escritura (crear, auto-aprobar, aprobar, rechazar) pasa por
    // app/api/banos/solicitudes-borrado/* con Admin SDK, que ignora estas
    // reglas — por eso el write queda cerrado también desde el cliente.
    match /solicitudes_borrado_banos/{solicitudId} {
      allow read: if esUsuarioAutorizado() && (esSuperAdminDoc() || esCorreoBreakGlass());
      allow write: if false;
    }

    // ── Horas Extra ──────────────────────────────────────────────────────────

    function horasExtraValido(d) {
      return d.empleado is string &&
             d.departamento in ['diseno', 'automatizacion', 'taller', 'cnc'] &&
             d.semanaInicio is string &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp;
    }

    // Edición restringida: super-admin, plantilla/rol admin, compras o
    // automatización (compras, contabilidad y el encargado de automatización)
    // o el flag por usuario `editaHorasExtra` para casos individuales.
    // Diseño y el resto: solo lectura. Mantener sincronizado con
    // `puedeEditarHorasExtra()` en `lib/roles.ts`.
    function puedeEditarHorasExtra() {
      return esUsuarioAutorizado() && (
        esCorreoBreakGlass() ||
        esSuperAdminDoc() ||
        docUsuario().rol in ['admin', 'compras', 'automatizacion'] ||
        docUsuario().plantilla in ['admin', 'compras', 'automatizacion'] ||
        ('editaHorasExtra' in docUsuario() && docUsuario().editaHorasExtra == true)
      );
    }

    match /horas-extra/{horaId} {
      allow read: if esUsuarioAutorizado();

      allow create: if puedeEditarHorasExtra()
                    && horasExtraValido(request.resource.data);

      allow update: if puedeEditarHorasExtra()
                    && horasExtraValido(request.resource.data)
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if puedeEditarHorasExtra();
    }

    // ── Mapeos SAT validados por el equipo ───────────────────────────────────

    match /sat_asignaciones/{asignacionId} {
      allow read: if esUsuarioAutorizado();

      allow create, update: if esUsuarioAutorizado()
        && request.resource.data.claveProdServ is string
        && request.resource.data.claveProdServ.matches('^\\d{8}$')
        && request.resource.data.tokensNormalizados is list
        && request.resource.data.descripcionEjemplo is string;

      allow delete: if esUsuarioAutorizado();
    }

    // ── Caja Chica ───────────────────────────────────────────────────────────

    // Los movimientos históricos pueden no tener adjunto. Cuando existe,
    // restringimos los metadatos al comprobante guardado bajo caja-chica/.
    function adjuntoCajaChicaValido(d) {
      return (!d.keys().hasAny(['archivoUrl']) ||
                d.archivoUrl == null ||
                (d.archivoUrl is string && d.archivoUrl.size() <= 3000)) &&
             (!d.keys().hasAny(['archivoNombre']) ||
                d.archivoNombre == null ||
                (d.archivoNombre is string && d.archivoNombre.size() <= 255)) &&
             (!d.keys().hasAny(['archivoPath']) ||
                d.archivoPath == null ||
                (d.archivoPath is string && d.archivoPath.matches('^caja-chica/.+')));
    }

    function movimientoCajaChicaValido(d) {
      return d.fecha is string &&
             d.periodo is string &&
             d.descripcion is string &&
             d.proveedor is string &&
             d.categoria is string &&
             d.solicitante is string &&
             d.comprobante in ['FACTURA', 'VALE', 'TICKET', 'NINGUNO'] &&
             d.deducible is bool &&
             d.tipo in ['ENTRADA', 'SALIDA'] &&
             d.monto is number &&
             d.costoReal is number &&
             d.ivaEstimado is number &&
             d.verificado is bool &&
             d.creadoEn is timestamp &&
             d.actualizadoEn is timestamp &&
             adjuntoCajaChicaValido(d);
    }

    match /caja_chica_movimientos/{movimientoId} {
      allow read: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('caja-chica'));

      allow create: if esUsuarioAutorizado()
                    && (esCorreoBreakGlass() || tieneModulo('caja-chica'))
                    && movimientoCajaChicaValido(request.resource.data);

      allow update: if esUsuarioAutorizado()
                    && (esCorreoBreakGlass() || tieneModulo('caja-chica'))
                    && movimientoCajaChicaValido(request.resource.data)
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('caja-chica'));
    }

    // Fondo fijo compartido de caja chica (antes solo en localStorage del navegador).
    match /caja_chica_config/{configId} {
      allow read: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('caja-chica'));
      allow create, update: if esUsuarioAutorizado()
                    && (esCorreoBreakGlass() || tieneModulo('caja-chica'))
                    && request.resource.data.fondoFijo is number
                    && request.resource.data.fondoFijo >= 0;
      allow delete: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('caja-chica'));
    }

    // Historial de arqueos (conteo físico vs saldo teórico) de caja chica.
    match /caja_chica_arqueos/{arqueoId} {
      allow read: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('caja-chica'));
      allow create: if esUsuarioAutorizado()
                    && (esCorreoBreakGlass() || tieneModulo('caja-chica'))
                    && request.resource.data.efectivoFisico is number
                    && request.resource.data.saldoTeorico is number
                    && request.resource.data.diferencia is number
                    && request.resource.data.creadoEn is timestamp;
      allow update, delete: if false;
    }

    // Cortes de caja chica (cierre de ciclo activo & reposición)
    match /caja_chica_cortes/{corteId} {
      allow read: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('caja-chica'));
      allow create: if esUsuarioAutorizado()
                    && (esCorreoBreakGlass() || tieneModulo('caja-chica'));
      allow update, delete: if esUsuarioAutorizado() && (esCorreoBreakGlass() || tieneModulo('caja-chica'));
    }

    // Notificaciones in-app: la única definición vive en la sección
    // "Notificaciones in-app (Operación del Taller)" más arriba. Aquí existía un
    // segundo `match /notificaciones` que concedía read/create/update/delete a
    // cualquier usuario autorizado; como Firestore hace OR entre bloques que
    // coinciden, ese duplicado anulaba por completo `notificacionValida()`,
    // `puedeCrearNotificacion()` y `puedeVerNotificacion()`. No volver a agregarlo.

    // ── Reportes Contables ───────────────────────────────────────────────────

    function reporteContableValido(d) {
      return d.fechaGeneracion is timestamp &&
             d.creadoPor is string &&
             d.totalLineas is number;
    }

    match /reportes_contables/{reporteId} {
      allow read: if esUsuarioAutorizado() && tieneModulo('reportes');
      allow create: if esUsuarioAutorizado() && tieneModulo('reportes')
                    && reporteContableValido(request.resource.data);
      allow update, delete: if false;
    }

    // ── Finanzas (espejo de solo lectura de facturación de clientes en Odoo) ─
    // Más sensible que compras: requiere módulo finanzas o super-admin.
    // Nunca se escribe desde el navegador — solo el Cloud Function de sync vía
    // Admin SDK, que ignora estas reglas.

    function esFinanzasAutorizado() {
      return esUsuarioAutorizado() &&
        (esCorreoBreakGlass() || tieneModulo('finanzas') || esSuperAdminDoc());
    }

    match /finanzas_facturas/{facturaId} {
      allow read: if esFinanzasAutorizado();
      allow write: if false;
    }

    match /finanzas_sync_state/{docId} {
      allow read: if esFinanzasAutorizado();
      allow write: if false;
    }

    function seguimientoCobranzaValido(d, facturaId) {
      return d.keys().hasOnly([
               'facturaId',
               'nota',
               'promesaPagoFecha',
               'enDisputa',
               'actualizadoEn',
               'actualizadoPor'
             ]) &&
             d.facturaId == facturaId &&
             d.facturaId.matches('^odoo_[0-9]+$') &&
             d.nota is string &&
             d.nota.size() <= 2000 &&
             d.promesaPagoFecha is string &&
             (
               d.promesaPagoFecha == '' ||
               d.promesaPagoFecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             ) &&
             d.enDisputa is bool &&
             d.actualizadoEn == request.time &&
             d.actualizadoPor == request.auth.token.email;
    }

    // Seguimiento operativo local. No modifica el espejo de Odoo y conserva
    // responsable + timestamp en cada escritura.
    match /finanzas_seguimiento/{facturaId} {
      allow read: if esFinanzasAutorizado();
      allow create, update: if esFinanzasAutorizado() &&
        seguimientoCobranzaValido(request.resource.data, facturaId);
      allow delete: if esFinanzasAutorizado();
    }

    // ── Auditoría (Registro de acciones) ─────────────────────────────────────
    
    match /auditoria/{auditId} {
      // Lectura: módulo auditoria, super-admin o break-glass
      allow read: if esUsuarioAutorizado() &&
        (esCorreoBreakGlass() || tieneModulo('auditoria') || esSuperAdminDoc());
      // Cualquier usuario del equipo puede generar un registro, pero no modificarlo ni borrarlo
      allow create: if esUsuarioAutorizado();
      allow update, delete: if false;
    }

    // ── Proveedores USA Tooling + inteligencia de compras ─────────────────────
    // Audit trail inmutable: creadoEn es timestamp al crear y nunca se reescribe.
    // La forma de los datos se valida con Zod en el cliente (lib/proveedores*.ts,
    // lib/requisiciones-flujo.ts) antes de escribir; no se replica aquí porque hay
    // merges parciales de un solo campo (p.ej. { ganadora }) que un esquema completo
    // rechazaría. ponytail: solo se blinda la trazabilidad (regla crítica); la
    // validación de tipos por campo queda deferida. Las cláusulas de inmutabilidad
    // son las mismas que ya corren en prod para /ordenes y /cotizaciones.

    function esProveedoresEditor() {
      return esUsuarioAutorizado() &&
        (esCorreoBreakGlass() || tieneModulo('proveedores') || esSuperAdminDoc());
    }

    match /proveedores/{proveedorId} {
      allow read: if esProveedoresAutorizado();
      allow delete: if esProveedoresEditor();
      allow create: if esProveedoresEditor()
                    && request.resource.data.creadoEn is timestamp;
      allow update: if esProveedoresEditor()
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn;
    }

    // Matriz de proveedor primario/backup por categoría (antes solo en useState local).
    match /proveedores_matriz_backup/{docId} {
      allow read: if esProveedoresAutorizado();
      allow create, update, delete: if esProveedoresEditor();
    }

    match /compras_proveedores/{compraId} {
      allow read: if esProveedoresAutorizado();
      allow delete: if esProveedoresEditor();
      allow create: if esProveedoresEditor()
                    && request.resource.data.creadoEn is timestamp;
      allow update: if esProveedoresEditor()
                    && request.resource.data.creadoEn == resource.data.creadoEn;
    }

    match /evaluaciones_proveedores/{evalId} {
      allow read: if esProveedoresAutorizado();
      allow delete: if esProveedoresEditor();
      allow create: if esProveedoresEditor()
                    && request.resource.data.creadoEn is timestamp;
      allow update: if esProveedoresEditor()
                    && request.resource.data.creadoEn == resource.data.creadoEn;
    }

    match /cotizaciones_comparador/{cotId} {
      allow read: if esProveedoresAutorizado();
      allow delete: if esProveedoresEditor();
      allow create: if esProveedoresEditor()
                    && request.resource.data.creadoEn is timestamp;
      allow update: if esProveedoresEditor()
                    && request.resource.data.creadoEn == resource.data.creadoEn;
    }

    match /cotizaciones_requisicion/{cotId} {
      allow read: if esProveedoresAutorizado();
      allow delete: if esProveedoresEditor();
      allow create: if esProveedoresEditor()
                    && request.resource.data.creadoEn is timestamp;
      allow update: if esProveedoresEditor()
                    && request.resource.data.creadoEn == resource.data.creadoEn;
    }

    // ── Compras Odoo (espejo solo lectura; escribe Admin SDK / Cloud Functions) ─

    function esProveedoresAutorizado() {
      return esUsuarioAutorizado() &&
        (
          esCorreoBreakGlass() ||
          tieneModulo('proveedores') ||
          tieneModulo('finanzas') ||
          esSuperAdminDoc()
        );
    }

    match /compras_odoo_po/{docId} {
      allow read: if esProveedoresAutorizado();
      allow write: if false;
    }

    match /compras_odoo_facturas/{docId} {
      allow read: if esProveedoresAutorizado();
      allow write: if false;
    }

    match /compras_odoo_items/{docId} {
      allow read: if esProveedoresAutorizado();
      allow update: if esUsuarioAutorizado()
                    && (esCorreoBreakGlass() || tieneModulo('proveedores') || esSuperAdminDoc())
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'categoriaId',
                      'tipoInsumo',
                      'tipoMetal',
                      'medida',
                      'clasificadoPorIa',
                      'actualizadoEn'
                    ]);
      allow create, delete: if false;
    }

    match /clasificacion_ia_mapeos/{mapeoId} {
      allow read: if esUsuarioAutorizado();
      allow create, update, delete: if esUsuarioAutorizado();
    }

    match /compras_odoo_sync_state/{docId} {
      allow read: if esProveedoresAutorizado();
      allow write: if false;
    }

    // Integridad del gasto: evidencia, workflow, configuración y eventos solo
    // atraviesan las callables. El Admin SDK de Functions ignora estas reglas.
    match /reportes_integridad_state/{docId} {
      allow read, write: if false;
    }

    match /reportes_integridad_runs/{runId} {
      allow read, write: if false;
    }

    match /reportes_integridad_run_cases/{caseId} {
      allow read, write: if false;
    }

    match /reportes_integridad_workflows/{caseId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /categorias_producto/{catId} {
      allow read: if esUsuarioAutorizado();
      allow write: if false;
    }

    // Tipo de cambio y config global: lectura para todos autorizados;
    // escritura solo admin (afecta rankings/recomendaciones de todo el equipo).
    match /config_sistema/{configId} {
      allow read: if esUsuarioAutorizado();
      allow create, update: if esFinanzasAutorizado()
        && request.resource.data.usdToMxn is number
        && request.resource.data.usdToMxn > 0;
      allow delete: if esFinanzasAutorizado();
    }

    // ── Búsqueda semántica (índice) ───────────────────────────────────────────
    // Solo Admin SDK en ambos extremos: el job de indexación (Functions,
    // busqueda-indice-sync.ts) escribe, y la ruta /api/busqueda-semantica lee
    // aplicando el filtro de permisos por módulo del lado del servidor (spec:
    // "el filtro ... ocurre en el servidor", no vía query directa del
    // cliente — no hay forma de expresar ese filtro por-fuente en una regla
    // de `list` sin que Firestore rechace la consulta completa). El Admin SDK
    // ignora estas reglas en ambos casos, igual que reportes_integridad_state.

    match /busqueda_indice/{docId} {
      allow read, write: if false;
    }

    match /busqueda_indice_sync_state/{docId} {
      allow read, write: if false;
    }

    // ── Configuraciones generales (Sincronización de Cotizaciones, etc.) ──────

    match /configuraciones/{configId} {
      allow read: if esUsuarioAutorizado();
      allow create, update, delete: if esFinanzasAutorizado();
    }

    // ── Documentos de venta (solicitudes remisión/factura + espejo Odoo) ─────

    function esDocumentosVentaAutorizado() {
      return esUsuarioAutorizado() &&
        (esCorreoBreakGlass() || tieneModulo('documentos-venta'));
    }

    function atiendeDocumentosVenta() {
      return esCorreoBreakGlass() || esSuperAdminDoc() ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
          docUsuario().atiendeDocumentosVenta == true);
    }

    function puedeLeerSolicitudDocumento() {
      return esDocumentosVentaAutorizado() && (
        atiendeDocumentosVenta() ||
        resource.data.solicitadoPorUid == request.auth.uid
      );
    }

    match /ventas_odoo_so/{soId} {
      allow read: if esDocumentosVentaAutorizado();
      allow write: if false;
    }

    match /ventas_odoo_sync_state/{docId} {
      allow read: if esDocumentosVentaAutorizado();
      allow write: if false;
    }

    match /solicitudes_documento/{solicitudId} {
      allow read: if puedeLeerSolicitudDocumento();

      // La creación pasa por /api/documentos-venta/solicitudes, que valida la
      // SO actual y reserva cantidades dentro de una transacción Admin. No
      // aceptar creates directos evita que una pestaña antigua salte esa
      // reserva y vuelva a introducir solicitudes duplicadas.
      allow create: if false;

      allow update: if esDocumentosVentaAutorizado()
                    && request.resource.data.creadoEn == resource.data.creadoEn
                    && request.resource.data.actualizadoEn >= resource.data.actualizadoEn
                    && request.resource.data.solicitadoPorUid == resource.data.solicitadoPorUid
                    && request.resource.data.tipo == resource.data.tipo
                    && request.resource.data.odooSoId == resource.data.odooSoId
                    && (
                      atiendeDocumentosVenta() ||
                      (
                        resource.data.solicitadoPorUid == request.auth.uid &&
                        resource.data.estado == 'pendiente' &&
                        request.resource.data.estado == 'rechazada'
                      )
                    );

      allow delete: if false;

      match /mensajes/{mensajeId} {
        allow read: if esDocumentosVentaAutorizado() && (
          atiendeDocumentosVenta() ||
          get(/databases/$(database)/documents/solicitudes_documento/$(solicitudId)).data.solicitadoPorUid
            == request.auth.uid
        );

        allow create: if esDocumentosVentaAutorizado()
                      && request.resource.data.autorUid == request.auth.uid
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 4000
                      && request.resource.data.autorNombre is string
                      && request.resource.data.creadoEn is timestamp
                      && (
                        atiendeDocumentosVenta() ||
                        get(/databases/$(database)/documents/solicitudes_documento/$(solicitudId)).data.solicitadoPorUid
                          == request.auth.uid
                      );

        allow update, delete: if false;
      }
    }

    // ── Todo lo demás: denegado por defecto ──────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
